# Development values only. Never commit real secrets (make secrets-check enforces this).
# Production must override every one of these; the API refuses to start with development values.
ISD_ENV=dev
# Runtime role (no schema changes; cannot rewrite the audit log, config history or ledgers):
DATABASE_URL=postgresql+psycopg://isd_app:isd_app_dev_only@localhost:5432/isd
# Schema owner, used only for migrations, seeding and the scripts:
MIGRATION_DATABASE_URL=postgresql+psycopg://isd:isd_dev_only@localhost:5432/isd
SECRET_KEY=change-me
PUBLIC_LOG_SALT=change-me
TOKEN_TTL_SECONDS=1800
SSO_MOCK_ENABLED=true
